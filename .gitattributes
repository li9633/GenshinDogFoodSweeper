# 自动检测文本文件，统一换行符为 LF（仓库内），Windows 拉取时自动转为 CRLF
* text=auto

# Python 文件
*.py text eol=lf

# 配置文件
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# 前端文件
*.ts text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.d.ts text eol=lf

# UI 文件
*.qml text eol=lf
*.conf text eol=lf
qmldir text eol=lf

# Markdown / 文档
*.md text eol=lf

# Shell 脚本
*.sh text eol=lf
*.ps1 text eol=lf

# 构建 / 打包
*.spec text eol=lf

# 二进制文件（禁止 Git 做换行符转换）
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.db binary
*.exe binary
*.dll binary
*.pyd binary
*.whl binary
*.otf binary

# 锁文件
pnpm-lock.yaml text eol=lf
package-lock.json text eol=lf
uv.lock text eol=lf