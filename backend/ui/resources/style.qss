/* ============================================================
   GenshinDogFoodSweeper — QSS 全局样式
   基于《原神》UI 设计语言：深渊蓝底 + 月华金描边
   仅供开源项目使用
   ============================================================ */

/* === 全局默认 === */
* {
    font-family: "Microsoft YaHei", "Noto Sans SC", "Source Han Sans SC", sans-serif;
    font-size: 14px;
    color: #F0EDE5;
}

QMainWindow {
    background-color: #1A1B2E;
}

QWidget {
    background-color: #1A1B2E;
    color: #F0EDE5;
}

QLabel {
    color: #F0EDE5;
    background: transparent;
}

/* === 标题文字 === */
QLabel[class="title"] {
    font-size: 16px;
    font-weight: bold;
    color: #C9A96E;
}

QLabel[class="subtitle"] {
    font-size: 14px;
    font-weight: 600;
    color: #C9A96E;
}

QLabel[class="hint"] {
    font-size: 12px;
    color: #B8B5C0;
}

/* === 按钮 === */
QPushButton {
    padding: 8px 20px;
    border: 1px solid #3A3D5C;
    border-radius: 6px;
    background-color: #252640;
    color: #B8B5C0;
    font-size: 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2E3055;
    border-color: #5A5E8A;
    color: #F0EDE5;
}

QPushButton:pressed {
    background-color: #1A1B2E;
}

QPushButton:disabled {
    background-color: #252640;
    border-color: #3A3D5C;
    color: #6B6E8A;
}

/* 主按钮（金色） */
QPushButton[class="primary"] {
    background-color: #C9A96E;
    border: 1px solid #C9A96E;
    color: #1A1B2E;
    font-weight: 600;
}

QPushButton[class="primary"]:hover {
    background-color: #E8D5A3;
    border-color: #E8D5A3;
    color: #1A1B2E;
}

QPushButton[class="primary"]:pressed {
    background-color: #C9A96E;
}

QPushButton[class="primary"]:disabled {
    background-color: #6B6E8A;
    border-color: #6B6E8A;
    color: #3A3D5C;
}

/* 危险按钮（红色） */
QPushButton[class="danger"] {
    background-color: #EF5350;
    border: 1px solid #EF5350;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton[class="danger"]:hover {
    background-color: #F44336;
    border-color: #F44336;
}

QPushButton[class="danger"]:pressed {
    background-color: #D32F2F;
}

/* 图标按钮 */
QPushButton[class="icon-btn"] {
    padding: 6px 10px;
    border: none;
    background: transparent;
    color: #B8B5C0;
}

QPushButton[class="icon-btn"]:hover {
    background-color: rgba(201, 169, 110, 0.1);
    color: #C9A96E;
    border-radius: 6px;
}

/* === 输入框 === */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    padding: 6px 10px;
    border: 1px solid #3A3D5C;
    border-radius: 6px;
    background-color: #252640;
    color: #F0EDE5;
    font-size: 14px;
    selection-background-color: #C9A96E;
    selection-color: #1A1B2E;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #C9A96E;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #252640;
    border: 1px solid #3A3D5C;
    border-radius: 6px;
    color: #F0EDE5;
    selection-background-color: #2E3055;
    selection-color: #C9A96E;
    outline: none;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2E3055;
    color: #E8D5A3;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    border: none;
    background-color: #2E3055;
    border-radius: 3px;
    margin: 2px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #3A3D5C;
}

/* === 复选框 === */
QCheckBox {
    spacing: 8px;
    color: #B8B5C0;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3A3D5C;
    border-radius: 3px;
    background-color: #252640;
}

QCheckBox::indicator:checked {
    background-color: #C9A96E;
    border-color: #C9A96E;
}

QCheckBox::indicator:hover {
    border-color: #5A5E8A;
}

/* === 分组框 === */
QGroupBox {
    font-size: 14px;
    font-weight: 600;
    color: #C9A96E;
    border: 1px solid #3A3D5C;
    border-radius: 8px;
    margin-top: 16px;
    padding: 20px 12px 12px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #C9A96E;
}

/* === 对话框 === */
QDialog {
    background-color: #1A1B2E;
    color: #F0EDE5;
    border: 1px solid #C9A96E;
    border-radius: 12px;
}

/* === 分割线 === */
QFrame[class="separator"] {
    background-color: #3A3D5C;
    max-height: 1px;
    border: none;
}

/* === 状态栏 === */
QStatusBar {
    background-color: #1A1B2E;
    color: #6B6E8A;
    border-top: 1px solid #3A3D5C;
    font-size: 12px;
    padding: 4px 8px;
}

/* === 滚动条 === */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3A3D5C;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5A5E8A;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #3A3D5C;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #5A5E8A;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* === 滑块 === */
QSlider::groove:horizontal {
    height: 6px;
    background-color: #2E3055;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background-color: #C9A96E;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #E8D5A3;
}

QSlider::sub-page:horizontal {
    background-color: #C9A96E;
    border-radius: 3px;
}

/* === 进度条 === */
QProgressBar {
    height: 6px;
    background-color: #2E3055;
    border: none;
    border-radius: 3px;
    text-align: center;
    font-size: 11px;
    color: #B8B5C0;
}

QProgressBar::chunk {
    background-color: #C9A96E;
    border-radius: 3px;
}

/* === 标签页 === */
QTabWidget::pane {
    border: 1px solid #3A3D5C;
    border-radius: 6px;
    background-color: #1A1B2E;
}

QTabBar::tab {
    padding: 8px 20px;
    border: 1px solid #3A3D5C;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    background-color: #252640;
    color: #B8B5C0;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #1A1B2E;
    color: #C9A96E;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #2E3055;
    color: #E8D5A3;
}

/* === 工具提示 === */
QToolTip {
    background-color: #252640;
    color: #F0EDE5;
    border: 1px solid #3A3D5C;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* === 导航栏 (el-menu 风格) === */
QWidget[class="nav"] {
    background-color: #111224;
    border: none;
}

QPushButton[class="nav-btn"] {
    padding: 12px 20px;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    background: transparent;
    color: #8B8EA8;
    font-size: 14px;
    text-align: left;
}

QPushButton[class="nav-btn"]:hover {
    background-color: rgba(201, 169, 110, 0.06);
    color: #E8D5A3;
}

QPushButton[class="nav-btn"][active="true"] {
    border-left: 3px solid #C9A96E;
    background-color: rgba(201, 169, 110, 0.10);
    color: #C9A96E;
    font-weight: 600;
}